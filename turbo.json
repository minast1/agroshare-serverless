{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:bundle-migrations"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "infra:bootstrap": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**/*.ts",
        "esbuild.cjs",
        "tsconfig.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "infra:deploy": {
      "dependsOn": [
        "build",
        "^infra:deploy"
      ],
      "inputs": [
        "infra/**/*.tf",
        "infra/**/*.tfvars"
      ],
      "cache": false
    },
    "db:bundle-migrations": {
      "cache": false,
      "inputs": [
        "migrations/**/*.sql",
        "scripts/bundle-migrations.ts"
      ],
      "outputs": [
        "src/migrations-registry.ts"
      ]
    }
  }
}